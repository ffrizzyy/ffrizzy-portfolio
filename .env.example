# Copy to .env.local and fill in what you need.
#
# Everything here is optional. With no secrets configured the site still runs:
# the contact route validates the payload and returns a labelled development
# response instead of sending mail (spec 1.4).

# Used for canonical URLs, the sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery through Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=m.farrel2222@gmail.com
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile. The widget only renders when the site key is present.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Leaflet tiles, used on the Portal Publik case study.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Optional cookieless analytics. Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
